### reference-ids
@reference
### reference-ips ips
@reference
### external-net-misses-internal-resolver
alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"x"; dns.query; content:"harbor"; sid:1;)
### dns-plain-content
alert dns any any -> any any (msg:"x"; dns.query; content:"harbor-sync.example"; sid:1;)
### dns-nocase
alert dns any any -> any any (msg:"x"; dns.query; content:"harbor-sync.example"; nocase; sid:1;)
### dns-endswith
alert dns any any -> any any (msg:"x"; dns.query; content:"harbor-sync.example"; nocase; endswith; sid:1;)
### dns-dot-without-dotprefix
alert dns any any -> any any (msg:"x"; dns.query; content:".harbor-sync.example"; nocase; endswith; sid:1;)
### dns-dotprefix-no-nocase
alert dns any any -> any any (msg:"x"; dns.query; dotprefix; content:".harbor-sync.example"; endswith; sid:1;)
### dns-established-never-matches
alert dns any any -> any any (msg:"x"; flow:established,to_server; dns.query; content:"harbor"; sid:1;)
### dns-to-server
alert dns any any -> any any (msg:"x"; flow:to_server; dns.query; content:"harbor"; sid:1;)
### dns-header-only
alert dns any any -> any any (msg:"x"; sid:1;)
### dns-cidr-source
alert dns 10.20.4.0/24 any -> any any (msg:"x"; dns.query; content:"harbor"; sid:1;)
### dns-port-53
alert dns any any -> any 53 (msg:"x"; dns.query; content:"halden"; sid:1;)
### pass-header-only
alert dns any any -> any any (msg:"x"; dns.query; content:"harbor"; sid:1;)
pass dns 10.20.9.5 any -> any any (msg:"p"; sid:2;)
### pass-with-content
alert dns any any -> any any (msg:"x"; dns.query; content:"harbor"; sid:1;)
pass dns 10.20.9.5 any -> any any (msg:"p"; dns.query; content:"harbor"; sid:2;)
### pass-other-event-does-not-suppress
pass tls any any -> any any (msg:"x"; tls.sni; content:"evil"; sid:1;)
alert tls any any -> any any (msg:"y"; tls.sni; content:"harbor"; sid:2;)
### http-uri-contains
alert http any any -> any any (msg:"x"; http.uri; content:"collect"; sid:1;)
### http-uri-startswith
