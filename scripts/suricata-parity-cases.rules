alert tls any any -> any any (msg:"x"; tls.sni; content:"harbor"; sid:1; rev:2; classtype:trojan-activity;)
### tls-fast-pattern
alert tls any any -> any any (msg:"x"; tls.sni; content:"sync"; fast_pattern; sid:1;)
